      }
    },
    "payment": {
      "type": "array",
      "description": "Payment service configurations.",
      "items": {
        "$ref": "#/$defs/ServiceConfigurationDto"
      }
    },
    "tax": {
      "type": "array",
      "description": "Tax service configurations.\n\n**The `tax` field is in preview mode** - some of the features may not be fully operational yet.",
