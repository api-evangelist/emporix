      "type": "boolean",
      "description": "Indicates whether prices for the site should be returned in gross (when includesTax=true) or net (when includesTax=false). "
    },
    "defaultLanguage": {
      "type": "string",
      "description": "Site's default language, compliant with the IETF BCP-47 standard. Regional variants such as `fr-ca` are supported.",
      "minLength": 2,
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "languages": {
      "type": "array",
      "description": "Languages supported by the site.\n\n**Note**: The languages must be compliant with the IETF BCP-47 standard. Regional variants such as `fr-ca` are supported.",
      "items": {
        "type": "string",
        "minLength": 2,
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
      }
    },
    "currency": {
      "$ref": "#/$defs/CurrencyDto"
    },
