{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/emporix/main/json-schema/emporix-site-dto-schema.json",
  "title": "Site",
  "description": "Information about the site.",
  "x-generated": "2026-10-18",
