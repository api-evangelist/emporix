          "$ref": "#/$defs/McpToolInvocationMethod"
        },
        "argsLocation": {
          "$ref": "#/$defs/McpToolInvocationArgsLocation"
        }
      }
    },
    "McpToolResponse": {
      "type": "object",
      "description": "Tool definition for a dynamic MCP server.\n\n**Dynamic MCP tools are in preview mode** - some of the features may not be fully operational yet.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique name of the tool. Contains only letters, numbers, and underscores."
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the tool."
        },
        "prompt": {
          "type": "string",
          "description": "Prompt that defines when and why the agent should call this tool."
        },
        "enabled": {
          "type": "boolean",
          "description": "An indicator whether the tool is enabled."
        },
        "config": {
          "$ref": "#/$defs/McpToolConfigResponse"
        }
      }
    },
    "MetadataRequest": {
      "type": "object",
      "properties": {
        "version": {
          "minimum": 1,
          "type": "integer",
          "description": "Version of the object. The version is required during the update operation because of the optimistic locking mechanism."
        }
      },
      "required": [
        "version"
      ]
    },
    "MetadataResponse": {
      "allOf": [
        {
          "$ref": "#/$defs/MetadataRequest"
        },
        {
          "type": "object",
          "properties": {
            "createdAt": {
              "description": "Date and time when the object was created. The value is approved as an ISO-8601 representation of an Instant. For example: `2022-04-30T13:18:02.379Z`",
              "type": "string"
            },
            "modifiedAt": {
              "description": "Date and time when the object was last modified. The value is approved as an ISO-8601 representation of an Instant. For example: `2022-04-30T13:18:02.379Z`",
              "type": "string"
            }
          },
          "required": [
            "version",
            "createdAt",
            "modifiedAt"
          ]
        }
      ]
    },
    "ModifiedBy": {
      "type": "object",
      "description": "Who last changed the agent.",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "CUSTOMER",
            "EMPLOYEE",
            "EXTERNAL",
            "SYSTEM"
          ],
          "description": "Identity recorded for the change. `EXTERNAL` is assigned when the request authenticates with an API token. `SYSTEM` is used for automatic updates.\n"
        },
        "id": {
          "type": "string",
          "description": "Identifier of the customer or employee. Omitted for `EXTERNAL` and `SYSTEM`. `id` is the `Hybris-User-Id` header value when `CUSTOMER` or `EMPLOYEE`."
        },
        "firstName": {
          "type": "string",
          "description": "First name of the customer or employee."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the customer or employee."
        }
      }
    },
    "NativeToolType": {
      "type": "string",
      "enum": [
        "slack",
        "rag_custom",
        "rag_emporix",
        "teams"
      ],
      "description": "Type of the native tool. Possible values:\n* `slack`\n* `rag_custom`\n* `rag_emporix`\n* `teams`"
    },
    "NativeToolsResponse": {
      "type": "array",
      "description": "List of native tools which agents should have access to.",
